# Copy to .env.local and fill in your Supabase credentials
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL — drives canonical links, sitemap.xml and OG tags.
# Defaults to https://recepti.rs, so set it to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to exactly "false" to keep search engines out (robots.txt Disallow: /
# plus a site-wide noindex). Anything else, including unset, allows indexing.
# Use this until real content is published.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Server-only. Never expose these to the browser. ---

# Required by scripts/seed-recipes.ts and scripts/create-admin.ts.
# Settings → API → service_role secret. Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by `npm run create-admin`. Password must be at least 12 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
